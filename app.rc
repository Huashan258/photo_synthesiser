// Windows 资源文件：程序图标（资源 ID 必须为 1）
// icon.ico 由 tools/make_icon.py 从 icon.png 生成
#include <winres.h>

1 ICON "icon.ico"

// 文件属性里显示的版本信息（右键 exe -> 属性 -> 详细信息）
1 VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "Huashan258"
            VALUE "FileDescription",  "Photo Stitcher - simple image stitching tool"
            VALUE "FileVersion",      "1.0.1"
            VALUE "InternalName",     "photo_synthesiser"
            VALUE "OriginalFilename", "photo_synthesiser.exe"
            VALUE "ProductName",      "Photo Stitcher"
            VALUE "ProductVersion",   "1.0.1"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
